# ==============================================================================
# Supermarket Chain Management System (ADBMS) - Root .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Sensitive Configs
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.env
application-local.properties
application-local.yml

# ------------------------------------------------------------------------------
# 2. Operating System & Local Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ------------------------------------------------------------------------------
# 3. IDEs & Editors
# ------------------------------------------------------------------------------
# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# Eclipse
.apt_generated/
.classpath
.factorypath
.project
.settings/
.springBeans

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/
*.sublime-project
*.sublime-workspace

# ------------------------------------------------------------------------------
# 4. Frontend (Angular, Node, npm)
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
dist/
frontend/dist/
tmp/
frontend/tmp/
out-tsc/
frontend/out-tsc/
.angular/
frontend/.angular/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Testing & Coverage
coverage/
frontend/coverage/
.nyc_output/
*.lcov
testem.log

# ------------------------------------------------------------------------------
# 5. Backend (Java 17, Spring Boot, Maven)
# ------------------------------------------------------------------------------
target/
backend/target/
*.class
*.war
*.ear
*.nar
*.rar

# Executable jars (build artifacts)
backend/target/*.jar
*.jar
!**/mvnw
!**/.mvn/wrapper/maven-wrapper.jar

# JVM Crash logs
hs_err_pid*
replay_pid*

# ------------------------------------------------------------------------------
# 6. Python & Bulk Data Generator (seed_bulk)
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
venv/
.venv/
env/
ENV/

# ------------------------------------------------------------------------------
# 7. Database Scratch & Dumps
# ------------------------------------------------------------------------------
*.dump
*.backup
*.sqlite
*.sqlite3
database/backups/*.sql.gz
database/scratch/
